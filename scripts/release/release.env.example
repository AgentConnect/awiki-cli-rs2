# Copy this file to `scripts/release/release.env.local` and fill in the
# secrets locally. `*.local` files are intentionally ignored by git.

# Optional proxy override for GitHub/npm network access. Leave unset or empty to
# use the current system/terminal network defaults.
# AWIKI_RELEASE_PROXY_URL=http://127.0.0.1:7897

# Optional but recommended for GitHub API polling and release asset mirroring.
# GITHUB_TOKEN=

# Required when Gitee mirroring is enabled.
# GITEE_TOKEN=
GITEE_GIT_URL=git@gitee.com:agentconnect/awiki-cli.git

# Required when npm publishing is enabled and the package version is not
# already present on npm.
# NODE_AUTH_TOKEN=

# Optional release defaults.
# AWIKI_RELEASE_GITHUB_TIMEOUT_SECONDS=3600
# AWIKI_RELEASE_NPM_TIMEOUT_SECONDS=900
