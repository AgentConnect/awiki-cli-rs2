#!/bin/sh
set -eu

BASE_URL="${AWIKI_DAEMON_BASE_URL:-${AWIKI_DAEMON_SERVICE_BASE_URL:-__AWIKI_DAEMON_BASE_URL__}}"
DEFAULT_DOWNLOAD_BASE_URLS='__AWIKI_DAEMON_DOWNLOAD_BASE_URLS__'
DOWNLOAD_BASE_URLS="${AWIKI_DAEMON_DOWNLOAD_BASE_URLS:-$DEFAULT_DOWNLOAD_BASE_URLS}"
TOKEN=""
VERSION=""
STATE_ROOT=""
FOREGROUND=0
CURL_CONNECT_TIMEOUT_SECONDS="${AWIKI_DAEMON_CURL_CONNECT_TIMEOUT_SECONDS:-20}"
CURL_MAX_TIME_SECONDS="${AWIKI_DAEMON_CURL_MAX_TIME_SECONDS:-900}"
CURL_RETRY_COUNT="${AWIKI_DAEMON_CURL_RETRY_COUNT:-3}"
CURL_RETRY_DELAY_SECONDS="${AWIKI_DAEMON_CURL_RETRY_DELAY_SECONDS:-2}"
CURL_SPEED_LIMIT_BYTES="${AWIKI_DAEMON_CURL_SPEED_LIMIT_BYTES:-1024}"
CURL_SPEED_TIME_SECONDS="${AWIKI_DAEMON_CURL_SPEED_TIME_SECONDS:-90}"
PROBE_CONNECT_TIMEOUT_SECONDS="${AWIKI_DAEMON_PROBE_CONNECT_TIMEOUT_SECONDS:-5}"
PROBE_MAX_TIME_SECONDS="${AWIKI_DAEMON_PROBE_MAX_TIME_SECONDS:-8}"

usage() {
  cat <<'USAGE'
Usage:
  install.sh --token <token> [--version <version>] [--state-root <path>] [--foreground]
USAGE
}

die() {
  echo "Error: $*" >&2
  exit 1
}

info() {
  printf '%s\n' "$*" >&2
}

normalize_config_value() {
  base_placeholder="__AWIKI_DAEMON_""BASE_URL__"
  download_placeholder="__AWIKI_DAEMON_""DOWNLOAD_BASE_URLS__"
  case "$1" in
    "$base_placeholder"|"$download_placeholder")
      printf '\n'
      ;;
    *)
      printf '%s\n' "$1"
      ;;
  esac
}

trim_trailing_slash() {
  value="$1"
  while [ "${value%/}" != "$value" ]; do
    value="${value%/}"
  done
  printf '%s\n' "$value"
}

infer_base_url_from_download_base_url() {
  download_base="$(trim_trailing_slash "$1")"
  case "$download_base" in
    http://*/daemon|https://*/daemon)
      printf '%s\n' "${download_base%/daemon}"
      ;;
    *)
      return 1
      ;;
  esac
}

validate_download_base_url() {
  case "$1" in
    http://*|https://*|file://*|/*|./*|../*) ;;
    *) die "daemon download base URL must be a URL or local path" ;;
  esac
}

join_download_path() {
  base="$(trim_trailing_slash "$1")"
  path="$2"
  while [ "${path#/}" != "$path" ]; do
    path="${path#/}"
  done
  case "$base" in
    file://*) printf '%s/%s\n' "$base" "$path" ;;
    /*|./*|../*) printf '%s/%s\n' "$base" "$path" ;;
    *) printf '%s/%s\n' "$base" "$path" ;;
  esac
}

normalize_download_sources() {
  "$PYTHON_BIN" - "$@" <<'PY'
import os
import sys

values = []
for value in sys.argv[1:]:
    if value:
        values.append(value)

for key in ("AWIKI_DAEMON_DOWNLOAD_BASE_URL",):
    value = os.environ.get(key, "")
    if value:
        values.append(value)

seen = set()
for raw in values:
    for line in raw.replace(",", "\n").splitlines():
        value = line.strip()
        if not value:
            continue
        while value.endswith("/"):
            value = value[:-1]
        if not value or value in seen:
            continue
        seen.add(value)
        print(value)
PY
}

validate_version_segment() {
  [ -n "$1" ] || die "daemon package version is empty"
  case "$1" in
    .*|*..*|*[!0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._-]*)
      die "daemon package version contains unsupported characters"
      ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --token)
      [ "$#" -ge 2 ] || die "--token requires a value"
      TOKEN="$2"
      shift 2
      ;;
    --version)
      [ "$#" -ge 2 ] || die "--version requires a value"
      VERSION="$2"
      shift 2
      ;;
    --state-root)
      [ "$#" -ge 2 ] || die "--state-root requires a path"
      STATE_ROOT="$2"
      shift 2
      ;;
    --foreground)
      FOREGROUND=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      die "unknown argument: $1"
      ;;
  esac
done

command -v tar >/dev/null 2>&1 || die "tar is required"
PYTHON_BIN=""
if command -v python3 >/dev/null 2>&1; then
  PYTHON_BIN="python3"
elif command -v python >/dev/null 2>&1; then
  PYTHON_BIN="python"
else
  die "python3 is required to parse manifest.json"
fi

BASE_URL="$(normalize_config_value "$BASE_URL")"
DOWNLOAD_BASE_URLS="$(normalize_config_value "$DOWNLOAD_BASE_URLS")"
DOWNLOAD_SOURCE_LIST="$(normalize_download_sources "$DOWNLOAD_BASE_URLS")"
DOWNLOAD_BASE_URL="$(printf '%s\n' "$DOWNLOAD_SOURCE_LIST" | sed -n '1p')"
if [ -z "$BASE_URL" ] && [ -n "$DOWNLOAD_BASE_URL" ]; then
  if inferred_base_url="$(infer_base_url_from_download_base_url "$DOWNLOAD_BASE_URL")"; then
    BASE_URL="$inferred_base_url"
  fi
fi
if [ -n "$BASE_URL" ]; then
  BASE_URL="$(trim_trailing_slash "$BASE_URL")"
fi

[ -n "$TOKEN" ] || die "--token is required"
[ -n "$BASE_URL" ] || die "daemon base URL is not configured"
[ -n "$DOWNLOAD_SOURCE_LIST" ] || die "daemon download base URL is not configured"
case "$BASE_URL" in
  http://*|https://*) ;;
  *) die "daemon base URL must start with http:// or https://" ;;
esac
printf '%s\n' "$DOWNLOAD_SOURCE_LIST" | while IFS= read -r download_source; do
  [ -n "$download_source" ] || continue
  validate_download_base_url "$download_source"
done

command -v curl >/dev/null 2>&1 || die "curl is required"

curl_with_route() {
  route="$1"
  src="$2"
  dest="$3"
  set -- curl -fL --show-error --progress-bar \
    --connect-timeout "$CURL_CONNECT_TIMEOUT_SECONDS" \
    --max-time "$CURL_MAX_TIME_SECONDS" \
    --retry "$CURL_RETRY_COUNT" \
    --retry-delay "$CURL_RETRY_DELAY_SECONDS" \
    --speed-limit "$CURL_SPEED_LIMIT_BYTES" \
    --speed-time "$CURL_SPEED_TIME_SECONDS"
  case "$route" in
    direct)
      set -- "$@" --noproxy '*'
      ;;
    env)
      ;;
    http://127.0.0.1:*)
      set -- "$@" --proxy "$route"
      ;;
    *)
      return 1
      ;;
  esac
  "$@" "$src" -o "$dest"
}

curl_route_list() {
  printf '%s\n' \
    "env" \
    "direct" \
    "http://127.0.0.1:7897" \
    "http://127.0.0.1:7890" \
    "http://127.0.0.1:7891" \
    "http://127.0.0.1:7892" \
    "http://127.0.0.1:1080" \
    "http://127.0.0.1:8080"
}

try_download_to() {
  src="$1"
  dest="$2"
  label="${3:-$(basename "$dest")}"
  route="${4:-}"
  case "$src" in
    file://*)
      info "Copying ${label} from local file..."
      "$PYTHON_BIN" - "$src" "$dest" <<'PY'
import shutil
import sys
from urllib.parse import unquote, urlparse

src, dest = sys.argv[1:3]
path = unquote(urlparse(src).path)
shutil.copyfile(path, dest)
PY
      ;;
    /*|./*|../*)
      info "Copying ${label} from local path..."
      cp "$src" "$dest"
      ;;
    *)
      info "Downloading ${label}..."
      if [ -n "$route" ]; then
        curl_with_route "$route" "$src" "$dest"
      else
        route_error_log="${TMP_DIR:-/tmp}/awiki-daemon-curl-routes.$$"
        : > "$route_error_log"
        for candidate_route in $(curl_route_list); do
          [ -n "$candidate_route" ] || continue
          if curl_with_route "$candidate_route" "$src" "$dest"; then
            return 0
          fi
          rm -f "$dest"
          printf '%s\n' "$candidate_route" >> "$route_error_log"
        done
        return 1
      fi
      ;;
  esac
}

download_to() {
  src="$1"
  dest="$2"
  label="${3:-$(basename "$dest")}"
  try_download_to "$src" "$dest" "$label" || die "download ${label} failed: $src"
}

case "$(uname -s)" in
  Darwin) OS="darwin" ;;
  Linux) OS="linux" ;;
  *) die "当前系统暂不支持 awiki daemon。第一版支持 macOS 和 Linux。" ;;
esac

case "$(uname -m)" in
  x86_64|amd64) ARCH="amd64" ;;
  arm64|aarch64) ARCH="arm64" ;;
  *) die "当前系统暂不支持 awiki daemon。第一版支持 macOS 和 Linux。" ;;
esac

TMP_DIR="${TMPDIR:-/tmp}/awiki-daemon-install.$$"
mkdir -p "$TMP_DIR"
cleanup() {
  rm -rf "$TMP_DIR"
}
trap cleanup EXIT INT TERM

validate_archive_entries() {
  "$PYTHON_BIN" - "$ARCHIVE_PATH" <<'PY' || die "daemon package validation failed"
import sys
import tarfile

archive_path = sys.argv[1]
expected = {
    "awiki-deamon": "file",
    "awiki-deamon-runtime": "runtime",
    "README.txt": "file",
    "LICENSE": "file",
    "checksums.txt": "file",
}
seen = set()

try:
    with tarfile.open(archive_path, "r:gz") as archive:
        for member in archive.getmembers():
            name = member.name
            while name.startswith("./"):
                name = name[2:]
            if (
                not name
                or name.startswith("/")
                or name in {".", ".."}
                or name.startswith("../")
                or "/../" in name
                or name.endswith("/..")
                or "//" in name
            ):
                raise SystemExit(f"unsafe daemon package path: {name or member.name}")
            if name not in expected:
                raise SystemExit(f"unexpected daemon package entry: {name}")
            if name in seen:
                raise SystemExit(f"duplicate daemon package entry: {name}")
            seen.add(name)

            expected_kind = expected[name]
            if expected_kind == "file":
                if not member.isfile():
                    raise SystemExit(f"daemon package entry must be a regular file: {name}")
            elif member.issym():
                if member.linkname != "awiki-deamon":
                    raise SystemExit("awiki-deamon-runtime symlink target is unsupported")
            elif not member.isfile():
                raise SystemExit("awiki-deamon-runtime must be a regular file or symlink")

        missing = sorted(set(expected) - seen)
        if missing:
            raise SystemExit(f"daemon package missing {', '.join(missing)}")
except tarfile.TarError as exc:
    raise SystemExit(f"daemon package listing failed: {exc}") from exc
PY
}

validate_extracted_package() {
  [ -f "$INSTALL_DIR/awiki-deamon" ] || die "daemon package does not contain awiki-deamon"
  [ ! -L "$INSTALL_DIR/awiki-deamon" ] || die "awiki-deamon must not be a symlink"
  [ -e "$INSTALL_DIR/awiki-deamon-runtime" ] || die "daemon package does not contain awiki-deamon-runtime"
  if [ -L "$INSTALL_DIR/awiki-deamon-runtime" ]; then
    command -v readlink >/dev/null 2>&1 || die "readlink is required to validate daemon runtime symlink"
    runtime_target="$(readlink "$INSTALL_DIR/awiki-deamon-runtime")"
    [ "$runtime_target" = "awiki-deamon" ] || die "awiki-deamon-runtime symlink target is unsupported"
  else
    [ -f "$INSTALL_DIR/awiki-deamon-runtime" ] || die "awiki-deamon-runtime must be a file or symlink"
  fi
  [ -f "$INSTALL_DIR/README.txt" ] || die "daemon package does not contain README.txt"
  [ -f "$INSTALL_DIR/LICENSE" ] || die "daemon package does not contain LICENSE"
  [ -f "$INSTALL_DIR/checksums.txt" ] || die "daemon package does not contain checksums.txt"
}

is_release_version_dir_name() {
  name="$1"
  [ -n "$name" ] || return 1
  case "$name" in
    .*|*..*|*[!0123456789._-]*|*.*) ;;
    *) return 1 ;;
  esac
  case "$name" in
    .*|*..*|*[!0123456789._-]*) return 1 ;;
  esac
  return 0
}

cleanup_daemon_bin_root() {
  bin_root="$1"
  current_version="$2"
  previous_version="$3"
  [ -d "$bin_root" ] || return 0
  for entry in "$bin_root"/* "$bin_root"/.upgrade-*; do
    [ -e "$entry" ] || continue
    name="$(basename "$entry")"
    [ "$name" != "current" ] || continue
    [ "$name" != "$current_version" ] || continue
    [ -z "$previous_version" ] || [ "$name" != "$previous_version" ] || continue
    case "$name" in
      .upgrade-*|*.backup.*)
        rm -rf "$entry"
        ;;
      *)
        if is_release_version_dir_name "$name"; then
          rm -rf "$entry"
        fi
        ;;
    esac
  done
}

MANIFEST_PATH="${TMP_DIR}/manifest.json"
MANIFEST_DOWNLOAD_BASE_URL=""
manifest_error_log="${TMP_DIR}/manifest-errors.txt"
: > "$manifest_error_log"
printf '%s\n' "$DOWNLOAD_SOURCE_LIST" | while IFS= read -r download_source; do
  [ -n "$download_source" ] || continue
  manifest_url="$(join_download_path "$download_source" "releases/manifest.json")"
  manifest_tmp="${MANIFEST_PATH}.$$"
  if try_download_to "$manifest_url" "$manifest_tmp" "daemon release manifest"; then
    mv "$manifest_tmp" "$MANIFEST_PATH"
    printf '%s\n' "$download_source" > "${TMP_DIR}/manifest-source.txt"
    exit 0
  fi
  rm -f "$manifest_tmp"
  printf '%s\n' "$download_source" >> "$manifest_error_log"
done
[ -f "$MANIFEST_PATH" ] || die "download daemon release manifest failed from all configured sources: $(tr '\n' ' ' < "$manifest_error_log")"
MANIFEST_DOWNLOAD_BASE_URL="$(cat "${TMP_DIR}/manifest-source.txt")"

selection="$($PYTHON_BIN - "$MANIFEST_PATH" "$OS" "$ARCH" "$VERSION" <<'PY'
import json
import sys

manifest_path, os_name, arch_name, requested = sys.argv[1:5]
manifest = json.load(open(manifest_path, "r", encoding="utf-8"))
version = requested or manifest.get("latest") or ""
for package in manifest.get("packages", []):
    if (
        str(package.get("version", "")) == version
        and package.get("os") == os_name
        and package.get("arch") == arch_name
    ):
        path = str(package.get("path", ""))
        if (
            not path
            or path.startswith("/")
            or path.startswith("./")
            or path.startswith("../")
            or "/../" in path
            or path.endswith("/..")
            or "\\" in path
        ):
            raise SystemExit(f"unsafe daemon package path: {path or '<empty>'}")
        print(package.get("version", ""))
        print(path)
        print(package.get("sha256", ""))
        break
else:
    raise SystemExit(f"no daemon package for {os_name}-{arch_name} version {version or '<latest>'}")
PY
)"

PKG_VERSION="$(printf '%s\n' "$selection" | sed -n '1p')"
PKG_PATH="$(printf '%s\n' "$selection" | sed -n '2p')"
PKG_SHA="$(printf '%s\n' "$selection" | sed -n '3p')"

[ -n "$PKG_VERSION" ] || die "manifest package version is empty"
[ -n "$PKG_PATH" ] || die "manifest package path is empty"
[ -n "$PKG_SHA" ] || die "manifest package sha256 is empty"
validate_version_segment "$PKG_VERSION"

ARCHIVE_PATH="${TMP_DIR}/awiki-deamon-${OS}-${ARCH}.tar.gz"
source_candidates_file="${TMP_DIR}/source-candidates.txt"
printf '%s\n' "$DOWNLOAD_SOURCE_LIST" > "$source_candidates_file"
route_candidates_file="${TMP_DIR}/route-candidates.txt"
curl_route_list > "$route_candidates_file"
ordered_sources_file="${TMP_DIR}/ordered-sources.txt"
"$PYTHON_BIN" - "$source_candidates_file" "$route_candidates_file" "$PKG_PATH" "$PROBE_CONNECT_TIMEOUT_SECONDS" "$PROBE_MAX_TIME_SECONDS" > "$ordered_sources_file" <<'PY'
import os
import shutil
import subprocess
import sys
import tempfile

source_file, route_file, package_path, connect_timeout, max_time = sys.argv[1:6]
sources = [line.strip() for line in open(source_file, encoding="utf-8") if line.strip()]
routes = [line.strip() for line in open(route_file, encoding="utf-8") if line.strip()]

def join(base, path):
    path = path.lstrip("/")
    return base.rstrip("/") + "/" + path

def is_local(base):
    return base.startswith("file://") or base.startswith("/") or base.startswith("./") or base.startswith("../")

def local_exists(base):
    if base.startswith("file://"):
        from urllib.parse import unquote, urlparse
        root = unquote(urlparse(base).path)
    else:
        root = base
    return os.path.exists(os.path.join(root, package_path.lstrip("/")))

ranked = []
for index, source in enumerate(sources):
    if is_local(source):
        score = 10**15 if local_exists(source) else -1
        ranked.append((score, -index, 0, source, "local"))
        continue
    curl = shutil.which("curl")
    if not curl:
        ranked.append((0, -index, 0, source, "env"))
        continue
    for route_index, route in enumerate(routes):
        fd, output = tempfile.mkstemp(prefix="awiki-daemon-probe-", suffix=".bin")
        os.close(fd)
        command = [
            curl,
            "-fL",
            "--silent",
            "--show-error",
            "--connect-timeout",
            connect_timeout,
            "--max-time",
            max_time,
            "--range",
            "0-262143",
            "--write-out",
            "%{speed_download}",
            "--output",
            output,
        ]
        if route == "direct":
            command += ["--noproxy", "*"]
        elif route.startswith("http://127.0.0.1:"):
            command += ["--proxy", route]
        elif route != "env":
            try:
                os.remove(output)
            except OSError:
                pass
            continue
        command.append(join(source, package_path))
        try:
            result = subprocess.run(
                command,
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True,
                check=False,
            )
            speed = float(result.stdout.strip() or "0") if result.returncode == 0 else 0
            ranked.append((speed, -index, -route_index, source, route))
        finally:
            try:
                os.remove(output)
            except OSError:
                pass

ranked.sort(key=lambda item: (item[0], item[1]), reverse=True)
for _score, _source_order, _route_order, source, route in ranked:
    print(f"{source}\t{route}")
PY

SELECTED_DOWNLOAD_BASE_URL=""
package_error_log="${TMP_DIR}/package-errors.txt"
: > "$package_error_log"
while IFS="$(printf '\t')" read -r download_source download_route; do
  [ -n "$download_source" ] || continue
  [ -n "$download_route" ] || download_route="env"
  pkg_url="$(join_download_path "$download_source" "$PKG_PATH")"
  rm -f "$ARCHIVE_PATH"
  if ! try_download_to "$pkg_url" "$ARCHIVE_PATH" "daemon package ${PKG_VERSION} for ${OS}-${ARCH}" "$download_route"; then
    printf '%s %s download_failed\n' "$download_source" "$download_route" >> "$package_error_log"
    continue
  fi

  if command -v shasum >/dev/null 2>&1; then
    ACTUAL_SHA="$(shasum -a 256 "$ARCHIVE_PATH" | awk '{print $1}')"
  elif command -v sha256sum >/dev/null 2>&1; then
    ACTUAL_SHA="$(sha256sum "$ARCHIVE_PATH" | awk '{print $1}')"
  else
    die "sha256 verification requires shasum or sha256sum"
  fi
  if [ "$ACTUAL_SHA" = "$PKG_SHA" ]; then
    SELECTED_DOWNLOAD_BASE_URL="$download_source"
    break
  fi
  printf '%s %s sha256_mismatch\n' "$download_source" "$download_route" >> "$package_error_log"
done < "$ordered_sources_file"

[ -n "$SELECTED_DOWNLOAD_BASE_URL" ] || die "download daemon package failed from all configured sources: $(tr '\n' ' ' < "$package_error_log")"

validate_archive_entries

INSTALL_DIR="${HOME}/.awiki-daemon/deamon/bin/${PKG_VERSION}"
CURRENT_DIR="${HOME}/.awiki-daemon/deamon/bin/current"
PREVIOUS_VERSION=""
if [ -L "$CURRENT_DIR/awiki-deamon" ]; then
  previous_target="$(readlink "$CURRENT_DIR/awiki-deamon" 2>/dev/null || true)"
  case "$previous_target" in
    ../*/awiki-deamon)
      PREVIOUS_VERSION="${previous_target#../}"
      PREVIOUS_VERSION="${PREVIOUS_VERSION%/awiki-deamon}"
      ;;
  esac
fi
EXTRACT_DIR="${TMP_DIR}/extract/${PKG_VERSION}"
mkdir -p "$EXTRACT_DIR" "$CURRENT_DIR"
tar -C "$EXTRACT_DIR" -xzf "$ARCHIVE_PATH"
INSTALL_DIR="$EXTRACT_DIR"
validate_extracted_package
chmod 0755 "$INSTALL_DIR/awiki-deamon" 2>/dev/null || true
chmod 0755 "$INSTALL_DIR/awiki-deamon-runtime" 2>/dev/null || true
FINAL_INSTALL_DIR="${HOME}/.awiki-daemon/deamon/bin/${PKG_VERSION}"
rm -rf "$FINAL_INSTALL_DIR"
mkdir -p "$(dirname "$FINAL_INSTALL_DIR")"
mv "$EXTRACT_DIR" "$FINAL_INSTALL_DIR"
INSTALL_DIR="$FINAL_INSTALL_DIR"

rm -f "$CURRENT_DIR/awiki-deamon" "$CURRENT_DIR/awiki-deamon-runtime"
ln -s "../${PKG_VERSION}/awiki-deamon" "$CURRENT_DIR/awiki-deamon"
if [ -e "$INSTALL_DIR/awiki-deamon-runtime" ]; then
  ln -s "../${PKG_VERSION}/awiki-deamon-runtime" "$CURRENT_DIR/awiki-deamon-runtime"
else
  ln -s "../${PKG_VERSION}/awiki-deamon" "$CURRENT_DIR/awiki-deamon-runtime"
fi
cleanup_daemon_bin_root "${HOME}/.awiki-daemon/deamon/bin" "$PKG_VERSION" "$PREVIOUS_VERSION"

set -- "$CURRENT_DIR/awiki-deamon" install --token "$TOKEN"
set -- "$@" --base-url "$BASE_URL" --download-base-url "$SELECTED_DOWNLOAD_BASE_URL"
if [ -n "$STATE_ROOT" ]; then
  set -- "$@" --state-root "$STATE_ROOT"
fi
if [ "$FOREGROUND" = "1" ]; then
  set -- "$@" --foreground
fi
exec "$@"
