{
  "name": "@awiki/cli",
  "version": "1.0.16",
  "description": "Awiki command-line interface (awiki-cli)",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "awikiCli": {
    "minSupportedVersion": "1.0.16"
  },
  "bin": {
    "awiki-cli": "scripts/run.js"
  },
  "files": [
    "scripts/install.js",
    "scripts/run.js",
    "awiki-release.json"
  ],
  "scripts": {
    "install-binary": "node scripts/install.js",
    "postinstall": "node scripts/install.js",
    "test:installer": "node --test scripts/install.test.js scripts/run.test.js scripts/release/cli/config.test.js scripts/release/cli/deploy-nginx-config.test.js scripts/release/cli/render-nginx-download-zones.test.js scripts/release/cli/render-nginx-snippet.test.js scripts/release/cli/stage-release.test.js"
  }
}
